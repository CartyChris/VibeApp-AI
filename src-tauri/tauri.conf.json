{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeApp AI",
  "version": "1.1.0",
  "identifier": "ai.vibeapp.studio",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "VibeApp AI",
        "label": "main",
        "width": 1500,
        "height": 960,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "acceptFirstMouse": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 VibeApp AI",
    "shortDescription": "Build iOS, web and desktop apps by describing them.",
    "longDescription": "VibeApp AI is a native macOS studio for building, previewing, wrapping and shipping apps with AI. Bring your own OpenRouter or Google AI Studio key, pick from every frontier model, preview on every iPhone in portrait or landscape, and export to iOS, Electron or the web.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  }
}
